#!/bin/sh
# Block commits containing secrets. Requires gitleaks (brew install gitleaks).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found — install it with 'brew install gitleaks'." >&2
  echo "pre-commit: refusing to commit unscanned changes." >&2
  exit 1
fi

gitleaks protect --staged --redact --verbose
status=$?
if [ $status -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: gitleaks found a potential secret in the staged changes." >&2
  echo "pre-commit: rotate the credential first, then remove it from the commit." >&2
  exit $status
fi
